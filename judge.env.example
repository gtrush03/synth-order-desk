# Copy to judge.env, edit, then: set -a; source judge.env; set +a
# Where built output and runtime state go (default ./run)
TRU_PLAN_OUTPUT=$PWD/run
TRU_SOURCE=$PWD
TRU_PLAN_PORT=7790
# Local tools (leave unset to use PATH)
#TRU_FFMPEG=/opt/homebrew/bin/ffmpeg
#TRU_WHISPER_CLI=/opt/homebrew/bin/whisper-cli
#TRU_ROTE=$HOME/.local/bin/rote
#TRU_BUN_DIR=$HOME/.bun/bin
TRU_PYTHON=$PWD/.venv/bin/python
TRU_WHISPER_MODEL=$PWD/models/ggml-large-v3-turbo-q5_0.bin
TRU_WHISPER_VAD=$PWD/models/ggml-silero-v6.2.0.bin
# HydraDB (required for review turns)
HYDRADB_URI=bolt://127.0.0.1:7687
HYDRADB_USER=neo4j
HYDRADB_PASSWORD=
HYDRADB_DATABASE=default
# Hotdata (optional; your own key; also enable run/conversation/hotdata-allowance.json)
HOTDATA_API_KEY=
# RocketRide staging (optional; only for the standalone cloud proof adapter; never a production key)
ROCKETRIDE_URI=https://staging.rocketride.ai
ROCKETRIDE_APIKEY=
